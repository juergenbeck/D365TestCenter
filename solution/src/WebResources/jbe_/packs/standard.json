  "testCases": [
    {
      "jbe_testcaseid": "d1d2d3d4-0001-4000-8000-100000000001",
      "jbe_testid": "STD-TC01",
      "jbe_title": "Lead-Qualifizierung: Opportunity wird erstellt",
      "jbe_category": 100000005,
      "jbe_tags": "Lead,Opportunity,Sales",
      "jbe_userstories": "PROJ-2001",
      "jbe_enabled": true,
      "jbe_definitionjson": {
        "steps": [
          {
            "stepNumber": 1,
            "action": "CreateRecord",
            "entity": "lead",
            "alias": "lead1",
            "fields": {
              "firstname": "{GENERATED:firstname}",
              "lastname": "{GENERATED:lastname}",
              "emailaddress1": "{GENERATED:email}",
              "companyname": "JBE Test Firma Alpha",
              "subject": "JBE Test Bedarf {GENERATED:lastname}",
              "leadqualitycode": 1
            }
          },
          {
            "stepNumber": 2,
            "action": "ExecuteRequest",
            "requestName": "QualifyLead",
            "description": "Lead qualifizieren und dabei eine Opportunity erzeugen lassen",
            "fields": {
              "LeadId": {
                "$type": "EntityReference",
                "entity": "lead",
                "ref": "lead1"
              },
              "Status": {
                "$type": "OptionSetValue",
                "value": 3
              },
              "CreateAccount": false,
              "CreateContact": false,
              "CreateOpportunity": true
            }
          },
          {
            "stepNumber": 3,
            "action": "Wait",
            "waitSeconds": 5
          },
          {
            "stepNumber": 4,
            "action": "FindRecord",
            "entity": "opportunity",
            "alias": "opp_aus_lead",
            "filter": {
              "originatingleadid": "{lead1.id}"
            },
            "columns": [
              "name"
            ],
            "trackForCleanup": true,
            "onError": "continue",
            "description": "Die von der Plattform erzeugte Opportunity für den Cleanup mitführen"
          },
          {
            "stepNumber": 5,
            "action": "Assert",
            "target": "Query",
            "entity": "opportunity",
            "filter": {
              "originatingleadid": "{lead1.id}"
            },
            "field": "name",
            "operator": "Contains",
            "value": "{GENERATED:lastname}",
            "onError": "continue",
            "description": "Zum qualifizierten Lead ist eine Opportunity entstanden"
          }
        ]
      }
    },
    {
      "jbe_testcaseid": "d1d2d3d4-0002-4000-8000-100000000002",
      "jbe_testid": "STD-TC02",
      "jbe_title": "Verkaufschance gewinnen: Status und Abschlussaktivität",
      "jbe_category": 100000005,
      "jbe_tags": "Opportunity,Account,Abschluss",
      "jbe_userstories": "",
      "jbe_enabled": true,
      "jbe_definitionjson": {
        "steps": [
          {
            "stepNumber": 1,
            "action": "CreateRecord",
            "entity": "account",
            "alias": "account1",
            "fields": {
              "name": "{GENERATED:company}"
            },
            "description": "Kunde der Verkaufschance"
          },
          {
            "stepNumber": 2,
            "action": "CreateRecord",
            "entity": "opportunity",
            "alias": "opp1",
            "fields": {
              "name": "JBE Test Opportunity {GENERATED:guid}",
              "customerid@odata.bind": "/accounts({account1.id})",
              "estimatedvalue": 50000
            },
            "cleanupChildren": [
              {
                "entity": "opportunityclose",
                "lookupField": "opportunityid"
              }
            ],
            "description": "Verkaufschance zu diesem Kunden anlegen"
          },
          {
            "stepNumber": 3,
            "action": "ExecuteRequest",
            "requestName": "WinOpportunity",
            "description": "Verkaufschance gewinnen (die Plattform lehnt ein direktes Status-Update ab)",
            "fields": {
              "OpportunityClose": {
                "$type": "Entity",
                "entity": "opportunityclose",
                "fields": {
                  "opportunityid": {
                    "$type": "EntityReference",
                    "entity": "opportunity",
                    "ref": "opp1"
                  },
                  "subject": "JBE Test Abschluss",
                  "actualrevenue": {
                    "$type": "Money",
                    "value": 50000
                  }
                }
              },
              "Status": {
                "$type": "OptionSetValue",
                "value": 3
              }
            }
          },
          {
            "stepNumber": 4,
            "action": "Wait",
            "waitSeconds": 5
          },
          {
            "stepNumber": 5,
            "action": "Assert",
            "target": "Record",
            "recordRef": "{RECORD:opp1}",
            "field": "statecode",
            "operator": "Equals",
            "value": "1",
            "onError": "continue",
            "description": "Die Verkaufschance steht auf gewonnen"
          },
          {
            "stepNumber": 6,
            "action": "Assert",
            "target": "Query",
            "entity": "opportunityclose",
            "filter": {
              "opportunityid": "{opp1.id}"
            },
            "operator": "Exists",
            "onError": "continue",
            "description": "Die Plattform hat die Abschlussaktivität angelegt"
          }
        ]
      }
    },
    {
      "jbe_testcaseid": "d1d2d3d4-0004-4000-8000-100000000004",
      "jbe_testid": "STD-TC04",
      "jbe_title": "Kunde löschen: Kaskade auf verknüpfte Anfragen",
      "jbe_category": 100000005,
      "jbe_tags": "Account,Case,Kaskade",
      "jbe_userstories": "",
      "jbe_enabled": true,
      "jbe_definitionjson": {
        "steps": [
          {
            "stepNumber": 1,
            "action": "CreateRecord",
            "entity": "account",
            "alias": "account1",
            "fields": {
              "name": "{GENERATED:company}"
            },
            "description": "Kunde"
          },
          {
            "stepNumber": 2,
            "action": "CreateRecord",
            "entity": "contact",
            "alias": "contact1",
            "fields": {
              "firstname": "{GENERATED:firstname}",
              "lastname": "{GENERATED:lastname}",
              "emailaddress1": "{GENERATED:email}",
              "parentcustomerid_account@odata.bind": "/accounts({account1.id})"
            },
            "description": "Ansprechpartner des Kunden"
          },
          {
            "stepNumber": 3,
            "action": "CreateRecord",
            "entity": "incident",
            "alias": "case1",
            "fields": {
              "title": "JBE Test Anliegen {GENERATED:guid}",
              "customerid@odata.bind": "/accounts({account1.id})",
              "primarycontactid@odata.bind": "/contacts({contact1.id})"
            },
            "description": "Anfrage zu diesem Kunden"
          },
          {
            "stepNumber": 4,
            "action": "Assert",
            "target": "Query",
            "entity": "incident",
            "filter": {
              "customerid": "{account1.id}"
            },
            "operator": "Exists",
            "onError": "continue",
            "description": "Vor dem Löschen hängt die Anfrage am Kunden"
          },
          {
            "stepNumber": 5,
            "action": "DeleteRecord",
            "alias": "account1",
            "description": "Den Kunden löschen"
          },
          {
            "stepNumber": 6,
            "action": "Wait",
            "waitSeconds": 5
          },
          {
            "stepNumber": 7,
            "action": "Assert",
            "target": "Query",
            "entity": "incident",
            "filter": {
              "customerid": "{account1.id}"
            },
            "operator": "NotExists",
            "onError": "continue",
            "description": "Nach dem Löschen ist die Anfrage mitgelöscht"
          }
        ]
      }
    },
