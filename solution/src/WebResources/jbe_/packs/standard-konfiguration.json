{
  "packId": "standard-konfiguration",
  "name": "Standard CRM mit Konfiguration",
  "description": "Testfälle, die echte Kundenlogik prüfen und dafür eine eingerichtete Zielumgebung voraussetzen: eine aktive Routingregel, eine veröffentlichte Duplikaterkennungsregel oder ein aktives SLA für Cases. Ohne diese Einrichtung schlagen sie fehl, und zwar richtigerweise: sie messen dann die Umgebung und nicht das Werkzeug. Jeder Testfall nennt seine Voraussetzung im Titel und in der Beschreibung des betroffenen Schritts.",
  "color": "#ab47bc",
  "testCases": [
    {
      "jbe_testcaseid": "d1d2d3d4-0003-4000-8000-100000000003",
      "jbe_testid": "STD-TC03",
      "jbe_title": "Case-Eskalation: Routing in eine Warteschlange (braucht eine aktive Routingregel)",
      "jbe_category": 100000005,
      "jbe_tags": "Case,Routing,Service",
      "jbe_userstories": "PROJ-2002",
      "jbe_enabled": true,
      "jbe_definitionjson": {
        "steps": [
          {
            "stepNumber": 1,
            "action": "CreateRecord",
            "entity": "account",
            "alias": "account1",
            "fields": {
              "name": "{GENERATED:company}"
            },
            "description": "Kunde, dem der Case zugeordnet wird"
          },
          {
            "stepNumber": 2,
            "action": "CreateRecord",
            "entity": "incident",
            "alias": "case1",
            "fields": {
              "title": "Dringend: {GENERATED:text}",
              "prioritycode": 1,
              "caseorigincode": 1,
              "customerid@odata.bind": "/accounts({account1.id})"
            },
            "description": "Case mit hoher Priorität anlegen"
          },
          {
            "stepNumber": 3,
            "action": "Wait",
            "waitSeconds": 5
          },
          {
            "stepNumber": 4,
            "action": "Assert",
            "target": "Record",
            "recordRef": "{RECORD:case1}",
            "field": "ticketnumber",
            "operator": "IsNotNull",
            "onError": "continue",
            "description": "Die Plattform hat dem Case eine Ticketnummer vergeben"
          },
          {
            "stepNumber": 5,
            "action": "Assert",
            "target": "Query",
            "entity": "queueitem",
            "filter": {
              "objectid": "{case1.id}"
            },
            "operator": "Exists",
            "onError": "continue",
            "description": "Das Routing hat den Case in eine Warteschlange gelegt; das setzt eine aktive Routingregel auf der Umgebung voraus"
          }
        ]
      }
    },
    {
      "jbe_testcaseid": "d1d2d3d4-0006-4000-8000-100000000006",
      "jbe_testid": "STD-TC06",
      "jbe_title": "Account-Deduplizierung: Warnung bei gleicher E-Mail (braucht eine veröffentlichte Duplikaterkennungsregel)",
      "jbe_category": 100000006,
      "jbe_tags": "Account,Duplikat,DQM",
      "jbe_userstories": "",
      "jbe_enabled": true,
      "jbe_definitionjson": {
        "steps": [
          {
            "stepNumber": 1,
            "action": "CreateRecord",
            "entity": "account",
            "alias": "account1",
            "fields": {
              "name": "{GENERATED:company}",
              "emailaddress1": "{GENERATED:email}"
            }
          },
          {
            "stepNumber": 2,
            "action": "CreateRecord",
            "entity": "account",
            "alias": "acc_dup",
            "fields": {
              "name": "{GENERATED:company}",
              "emailaddress1": "{GENERATED:email}"
            }
          },
          {
            "stepNumber": 3,
            "action": "Wait",
            "waitSeconds": 5
          },
          {
            "stepNumber": 4,
            "action": "Assert",
            "target": "Query",
            "entity": "duplicaterecord",
            "filter": {
              "baserecordid": "{acc_dup.id}"
            },
            "operator": "Exists",
            "onError": "continue",
            "description": "Die Duplikaterkennung hat den doppelten Account gemeldet; das setzt eine veröffentlichte und aktive Duplikaterkennungsregel auf der Umgebung voraus"
          }
        ]
      }
    },
    {
      "jbe_testcaseid": "d1d2d3d4-0008-4000-8000-100000000008",
      "jbe_testid": "STD-TC08",
      "jbe_title": "Case-SLA: Timer startet bei Erstellung (braucht ein aktives SLA für Cases)",
      "jbe_category": 100000005,
      "jbe_tags": "Case,SLA,Timer,Service",
      "jbe_userstories": "PROJ-2002",
      "jbe_enabled": true,
      "jbe_definitionjson": {
        "steps": [
          {
            "stepNumber": 1,
            "action": "CreateRecord",
            "entity": "account",
            "alias": "account1",
            "fields": {
              "name": "{GENERATED:company}"
            },
            "description": "Kunde, dem der Case zugeordnet wird"
          },
          {
            "stepNumber": 2,
            "action": "CreateRecord",
            "entity": "incident",
            "alias": "sla_case",
            "fields": {
              "title": "SLA-Test {GENERATED:text}",
              "prioritycode": 2,
              "customerid@odata.bind": "/accounts({account1.id})"
            },
            "maxDurationMs": 10000,
            "description": "Case anlegen, an dem ein SLA greifen soll"
          },
          {
            "stepNumber": 3,
            "action": "Wait",
            "waitSeconds": 5
          },
          {
            "stepNumber": 4,
            "action": "Assert",
            "target": "Record",
            "recordRef": "{RECORD:sla_case}",
            "field": "slainvokedid",
            "operator": "IsNotNull",
            "onError": "continue",
            "description": "Beim Anlegen wurde ein SLA angewendet; das setzt ein aktives SLA für Cases auf der Umgebung voraus"
          }
        ]
      }
    }
  ],
